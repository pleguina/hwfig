% ---- parameters for the parametric pics ------------------------------------
% Set globally-in-scope with \hwset{...}, or per pic:  \pic (a) at (0,0) {aiearray={rows=2,cols=4}};
\pgfkeys{/hw/.is family,/hw/.cd,
  rows/.initial=3, cols/.initial=4, depth/.initial=3,
  dx/.initial=1.15, dy/.initial=0.85,
  labels/.initial={S1,S2,S3,S4},
  columns/.initial={C,C,D,C,B,C,C,D,C,B,C,C},  % fabric: C=CLB, D=DSP, B=BRAM, U=URAM, I=IO
  fabricrows/.initial=8,
  tilelabel/.initial={AIE},
  nocpe/.initial=true,
  legend/.initial={comp/Compute,quant/Quant.,mem/Memory,op/Operator,ctrl/Control,const/Const.}}
\newcommand\hwset[1]{\pgfkeys{/hw/.cd,#1}}
\def\hw@v#1{\pgfkeysvalueof{/hw/#1}}
\def\hw@true{true}

\tikzset{
  % bus-width tick:   \draw[bus] (a) -- (b) pic[pos=.5]{buswidth=32};
  % label sits right of the tick (clear of horizontal AND vertical wires);
  % buswidth' puts it on the left instead.
  pics/buswidth/.style={code={
    \draw[hwwire,line width=\hw@lw,-] (-2.5pt,-3.5pt)--(2.5pt,3.5pt);
    \node[font=\hw@ff\tiny,inner sep=1pt,text=hwwire,anchor=south west] at (3pt,1pt) {#1};}},
  pics/buswidth'/.style={code={
    \draw[hwwire,line width=\hw@lw,-] (-2.5pt,-3.5pt)--(2.5pt,3.5pt);
    \node[font=\hw@ff\tiny,inner sep=1pt,text=hwwire,anchor=south east] at (-3pt,1pt) {#1};}},
  % AIE tile: core (left 62%) + local data memory (right); the label is
  % centred on the core part
  aie/.style={hw@box=comp,minimum width=0.9cm,minimum height=0.62cm,inner sep=1pt,font=\hw@ff\tiny,
    execute at begin node={\hspace*{-0.3cm}},
    path picture={\fill[hwmemB] ($(path picture bounding box.south west)!0.62!(path picture bounding box.south east)$) rectangle (path picture bounding box.north east);
      \draw[hwmemL,sharp corners] ($(path picture bounding box.south west)!0.62!(path picture bounding box.south east)$)--($(path picture bounding box.north west)!0.62!(path picture bounding box.north east)$);}},
  %
  % pic{aiearray}: rows x cols AIE tiles + PL-interface shim row. Tiles: (<name>-t<r>-<c>) (r=1 bottom), shim: (<name>-s<c>), frame: (<name>-box)
  pics/aiearray/.default={},
  pics/aiearray/.style={code={\hwset{#1}%
    \pgfmathtruncatemacro\hwR{\hw@v{rows}}\pgfmathtruncatemacro\hwC{\hw@v{cols}}%
    \pgfmathsetmacro\hwdx{\hw@v{dx}}\pgfmathsetmacro\hwdy{\hw@v{dy}}%
    \foreach \c in {1,...,\hwC}{%
      \node[hw@box=io,minimum width=0.9cm,minimum height=0.32cm,inner sep=0pt,font=\hw@ff\tiny] (-s\c) at ({(\c-1)*\hwdx},{-0.78}) {shim};
      \foreach \r in {1,...,\hwR}{\node[aie] (-t\r-\c) at ({(\c-1)*\hwdx},{(\r-1)*\hwdy}) {\hw@v{tilelabel}};}}%
    \foreach \c in {1,...,\hwC}{\foreach \r in {1,...,\hwR}{%
      \ifnum\c<\hwC \draw[hwcwire,-{Latex[length=1.2mm]}] ({(\c-1)*\hwdx+0.45},{(\r-1)*\hwdy})--({\c*\hwdx-0.45},{(\r-1)*\hwdy});\fi
      \ifnum\r<\hwR \draw[hwcwire,-{Latex[length=1.2mm]}] ({(\c-1)*\hwdx-0.15},{(\r-1)*\hwdy+0.31})--({(\c-1)*\hwdx-0.15},{\r*\hwdy-0.31});\fi}%
      \draw[hwcwire,{Latex[length=1.2mm]}-{Latex[length=1.2mm]}] ({(\c-1)*\hwdx},-0.62)--({(\c-1)*\hwdx},-0.31);}%
    \node[group,fill=none,minimum width={(\hwC-1)*\hwdx*1cm+1.3cm},minimum height={(\hwR-1)*\hwdy*1cm+1.91cm},anchor=center]
      (-box) at ({(\hwC-1)*\hwdx/2},{((\hwR-1)*\hwdy-0.63)/2}) {};
  }},
  %
  % pic{systolic}: rows x cols PEs, data flows right, partial sums flow down. PEs: (<name>-pe<r>-<c>), r=1 is top row
  pics/systolic/.default={},
  pics/systolic/.style={code={\hwset{#1}%
    \pgfmathtruncatemacro\hwR{\hw@v{rows}}\pgfmathtruncatemacro\hwC{\hw@v{cols}}%
    \foreach \r in {1,...,\hwR}{\foreach \c in {1,...,\hwC}{%
      \node[pe] (-pe\r-\c) at ({(\c-1)*1.1},{-(\r-1)*1.1}) {PE};}}%
    \foreach \r in {1,...,\hwR}{\foreach \c in {1,...,\hwC}{%
      \ifnum\c<\hwC \draw[hwwire,-{Latex[length=1.5mm]}] ({(\c-1)*1.1+0.375},{-(\r-1)*1.1})--({\c*1.1-0.375},{-(\r-1)*1.1});\fi
      \ifnum\r<\hwR \draw[hwcwire,-{Latex[length=1.5mm]}] ({(\c-1)*1.1},{-(\r-1)*1.1-0.375})--({(\c-1)*1.1},{-\r*1.1+0.375});\fi}%
      \draw[hwwire,-{Latex[length=1.5mm]}] ({-0.85},{-(\r-1)*1.1})--({-0.375},{-(\r-1)*1.1});}%
    \foreach \c in {1,...,\hwC}{\draw[hwcwire,-{Latex[length=1.5mm]}] ({(\c-1)*1.1},0.85)--({(\c-1)*1.1},0.375);}%
  }},
  %
  % pic{addertree}: 2^depth inputs reduced by op nodes. Inputs (<name>-in<k>), adders (<name>-a<level>-<k>), output coord (<name>-out)
  pics/addertree/.default={},
  pics/addertree/.style={code={\hwset{#1}%
    \pgfmathtruncatemacro\hwD{\hw@v{depth}}\pgfmathtruncatemacro\hwN{2^\hwD}%
    \foreach \k in {1,...,\hwN}{\coordinate (-in\k) at (0,{(\hwN+1)/2*0.45-\k*0.45});
      \draw[hwwire] (-0.3,{(\hwN+1)/2*0.45-\k*0.45})--(0,{(\hwN+1)/2*0.45-\k*0.45});}%
    \foreach \l in {1,...,\hwD}{%
      \pgfmathtruncatemacro\m{2^(\hwD-\l)}\pgfmathsetmacro\hwsp{0.45*2^\l}%
      \foreach \k in {1,...,\m}{%
        \pgfmathtruncatemacro\ka{2*\k-1}\pgfmathtruncatemacro\kb{2*\k}\pgfmathtruncatemacro\lp{\l-1}%
        \pgfmathsetmacro\y{(\m+1)/2*\hwsp-\k*\hwsp}%
        \node[op,minimum size=0.42cm] (-a\l-\k) at ({\l*0.9},\y) {$+$};
        \pgfmathsetmacro\spp{0.45*2^\lp}\pgfmathtruncatemacro\mp{2^(\hwD-\lp)}%
        \pgfmathsetmacro\ya{(\mp+1)/2*\spp-\ka*\spp}\pgfmathsetmacro\yb{(\mp+1)/2*\spp-\kb*\spp}%
        \draw[hwwire,-{Latex[length=1.2mm]}] ({\lp*0.9+(\lp>0)*0.21},\ya) -| ({\l*0.9-0.35},\y) -- ({\l*0.9-0.21},\y);
        \draw[hwwire] ({\lp*0.9+(\lp>0)*0.21},\yb) -| ({\l*0.9-0.35},\y);}}%
    \coordinate (-out) at ({\hwD*0.9+0.21},0);
  }},
  %
  % pic{pipeline}: labelled stages separated by pipeline registers. Stages: (<name>-st<k>), regs (<name>-r<k>)
  pics/pipeline/.default={},
  pics/pipeline/.style={code={\hwset{#1}%
    \edef\hwlabels{\hw@v{labels}}%
    \foreach \lab [count=\k] in \hwlabels {%
      \node[hlsbox,minimum width=1.3cm] (-st\k) at ({(\k-1)*2.1},0) {\lab};
      \node[reg,minimum height=0.9cm] (-r\k) at ({(\k-1)*2.1+1.05},0) {};
      \draw[hwwire,-{Latex[length=1.5mm]}] (-st\k.east)--(-r\k.west);
      \ifnum\k>1 \pgfmathtruncatemacro\kp{\k-1}\draw[hwwire,-{Latex[length=1.5mm]}] (-r\kp.east)--(-st\k.west);\fi}%
  }},
  %
  % pic{fabric}: column-based FPGA floorplan sketch (CLB / DSP / BRAM / URAM / IO columns).
  % Tall sites (DSP/BRAM = 2 rows, URAM = 4 rows) are trimmed at the top so any
  % fabricrows value stays rectangular.  Column tops: (<name>-c<k>)
  pics/fabric/.default={},
  pics/fabric/.style={code={\hwset{#1}%
    \pgfmathtruncatemacro\hwR{\hw@v{fabricrows}}\edef\hwcols{\hw@v{columns}}%
    \foreach \t [count=\c] in \hwcols {%
      \foreach \r in {1,...,\hwR}{%
        \if\t C \fill[hwcompF,draw=hwcompD,line width=0.3pt] ({(\c-1)*0.32},{(\r-1)*0.32}) rectangle ++(0.26,0.26);\fi
        \if\t I \fill[hwioF,draw=hwioD,line width=0.6pt] ({(\c-1)*0.32},{(\r-1)*0.32}) rectangle ++(0.26,0.26);\fi}%
      \if\t D \foreach \r in {1,3,...,\hwR}{\pgfmathtruncatemacro\hh{min(2,\hwR-\r+1)}%
        \fill[hwopF,draw=hwopD,line width=0.3pt] ({(\c-1)*0.32},{(\r-1)*0.32}) rectangle ++(0.26,{\hh*0.32-0.06});}\fi
      \if\t B \foreach \r in {1,3,...,\hwR}{\pgfmathtruncatemacro\hh{min(2,\hwR-\r+1)}%
        \fill[hwmemF,draw=hwmemD,line width=0.3pt] ({(\c-1)*0.32},{(\r-1)*0.32}) rectangle ++(0.26,{\hh*0.32-0.06});}\fi
      \if\t U \foreach \r in {1,5,...,\hwR}{\pgfmathtruncatemacro\hh{min(4,\hwR-\r+1)}%
        \fill[hwmemD!40,draw=hwmemD,line width=0.3pt] ({(\c-1)*0.32},{(\r-1)*0.32}) rectangle ++(0.26,{\hh*0.32-0.06});}\fi
      \coordinate (-c\c) at ({(\c-1)*0.32+0.13},{\hwR*0.32});}%
  }},
  %
  % pic{noc}: rows x cols mesh of routers, each with an attached PE (nocpe=false hides them).
  % Routers: (<name>-n<r>-<c>), PEs: (<name>-pe<r>-<c>)
  pics/noc/.default={},
  pics/noc/.style={code={\hwset{#1}%
    \pgfmathtruncatemacro\hwR{\hw@v{rows}}\pgfmathtruncatemacro\hwC{\hw@v{cols}}%
    \edef\hw@tmp{\hw@v{nocpe}}%
    \foreach \r in {1,...,\hwR}{\foreach \c in {1,...,\hwC}{%
      \node[router,minimum size=0.6cm] (-n\r-\c) at ({(\c-1)*1.3},{-(\r-1)*1.3}) {R};
      \ifx\hw@tmp\hw@true
        \node[pe,minimum size=0.42cm,font=\hw@ff\tiny] (-pe\r-\c) at ({(\c-1)*1.3+0.52},{-(\r-1)*1.3+0.47}) {PE};
        \draw[hwcwire] (-n\r-\c.north east) -- (-pe\r-\c.south west);
      \fi}}%
    \foreach \r in {1,...,\hwR}{\foreach \c in {1,...,\hwC}{%
      \ifnum\c<\hwC \draw[hwwire,{Latex[length=1.2mm]}-{Latex[length=1.2mm]}] ({(\c-1)*1.3+0.32},{-(\r-1)*1.3})--({\c*1.3-0.32},{-(\r-1)*1.3});\fi
      \ifnum\r<\hwR \draw[hwwire,{Latex[length=1.2mm]}-{Latex[length=1.2mm]}] ({(\c-1)*1.3},{-(\r-1)*1.3-0.32})--({(\c-1)*1.3},{-\r*1.3+0.32});\fi}}%
  }},
  % pic{legend}: key of role swatches, spaced by label width.
  %   \pic at (x,y) {legend={legend={comp/Compute,mem/BRAM}}};
  % roles: io comp quant const op mem ctrl group
  swatch/.style={draw=hw#1D,fill=hw#1B,minimum width=0.32cm,minimum height=0.24cm,inner sep=0pt},
  pics/legend/.default={},
  pics/legend/.style={code={\hwset{#1}%
    \edef\hwleg{\hw@v{legend}}%
    \coordinate (-lg0) at (-0.4,0);
    \foreach \st/\tx [count=\i] in \hwleg {%
      \pgfmathtruncatemacro\ip{\i-1}%
      \node[swatch=\st,anchor=west] (-sw\i) at ($(-lg\ip.east)+(0.4,0)$) {};
      \node[anchor=west,font=\hw@ff\scriptsize,inner sep=2pt] (-lg\i) at (-sw\i.east) {\tx};}}},
}

% ---- v1.2 additions: flow / FSM / ML shapes, annotations, extra wires --------
\pgfkeys{/hw/.cd, layers/.initial={3,5,5,2}, lsep/.initial=1.3, nsep/.initial=0.5}
\tikzset{
  % paint the picture background with the palette's paper colour (dark palettes)
  % (drawn on its own layer below `background', so frames stay visible)
  hwcanvas/.style={execute at end picture={\begin{pgfonlayer}{hwcanvas}
    \fill[hwpaper] ($(current bounding box.south west)+(-6pt,-6pt)$) rectangle ($(current bounding box.north east)+(6pt,6pt)$);
    \end{pgfonlayer}}},
  % terminator / external port (pill)
  term/.style={hw@box=io,rounded rectangle,minimum height=0.6cm,minimum width=1.2cm,inner xsep=5pt,inner ysep=2pt,align=center},
  % decision / branch condition
  decision/.style={hw@box=ctrl,diamond,aspect=1.7,inner sep=1pt,align=center,font=\hw@ff\scriptsize},
  % FSM state, accepting / idle state
  state/.style={hw@box=ctrl,circle,minimum size=0.85cm,inner sep=1pt,align=center,font=\hw@ff\scriptsize},
  accstate/.style={state,double=hwpaper,double distance=1pt},
  % buffer / driver / amplifier (triangle pointing east)
  buf/.style={hw@box=comp,isosceles triangle,isosceles triangle apex angle=60,minimum height=0.65cm,inner sep=1pt,font=\hw@ff\tiny},
  % network / anything outside the system
  net/.style={hw@box=io,cloud,cloud puffs=10,cloud puff arc=110,aspect=1.9,inner sep=0pt,minimum width=1.9cm,minimum height=1.1cm,align=center},
  % neural-network unit
  neuron/.style={hw@box=comp,circle,minimum size=0.4cm,inner sep=0pt,font=\hw@ff\tiny},
  % wire junction:  \node[dot] at (fork) {};
  dot/.style={circle,fill=hwwire,inner sep=0pt,minimum size=2.8pt},
  % numbered call-out for step-by-step explanations
  badge/.style={circle,fill=hwaccent,text=hwpaper,inner sep=0pt,minimum size=0.36cm,font=\hw@ff\tiny\bfseries},
  % free annotation text
  note/.style={font=\hw@ff\scriptsize\itshape,text=hwcwire,align=left,inner sep=2pt},
  % "N copies of this block": add to any box style, e.g. [hlsbox,stack]
  % (in solid fill mode the copies get a paper-coloured outline so they stay distinct)
  stack/.code={\ifx\hw@fillmode\hw@solid
      \tikzset{double copy shadow={shadow xshift=2.4pt,shadow yshift=2.4pt,opacity=1,draw=hwpaper}}%
    \else\tikzset{double copy shadow={shadow xshift=2.4pt,shadow yshift=2.4pt,opacity=1}}\fi},
  % extra wires
  biarr/.style={hw@wire,draw=hwwire,{Latex[length=2mm]}-{Latex[length=2mm]}},
  ctlarr/.style={hw@wire,draw=hwctrlD,densely dashed,-{Latex[length=1.8mm]}},     % control / handshake
  link/.style={hw@wire,draw=hwwire,line width=1.2*\hw@lw,double=hwpaper,double distance=2.4*\hw@lw,
    -{Latex[length=2.8mm,width=2.6mm]}},                                    % serial / optical link
  % dimension brace:  \draw[brace] (a.north west) -- (a.north east) node[lbl,midway,above=5pt]{8 bit};
  brace/.style={draw=hwcwire,decorate,decoration={brace,amplitude=4pt,raise=2pt}},
  brace'/.style={draw=hwcwire,decorate,decoration={brace,amplitude=4pt,raise=2pt,mirror}},
  %
  % pic{mlp}: fully connected network. layers={3,5,5,2}, lsep (x pitch), nsep (y pitch).
  % Units: (<name>-l<layer>-<k>), k=1 on top
  pics/mlp/.default={},
  pics/mlp/.style={code={\hwset{#1}%
    \edef\hw@ly{\hw@v{layers}}%
    \pgfmathsetmacro\hw@ls{\hw@v{lsep}}\pgfmathsetmacro\hw@ns{\hw@v{nsep}}%
    \foreach \n [count=\l] in \hw@ly {%
      \expandafter\xdef\csname hw@mlp@\l\endcsname{\n}\xdef\hw@mlpL{\l}%
      \foreach \k in {1,...,\n}{\node[neuron] (-l\l-\k) at ({(\l-1)*\hw@ls},{((\n+1)/2-\k)*\hw@ns}) {};}}%
    \ifnum\hw@mlpL>1
      \foreach \l in {2,...,\hw@mlpL}{%
        \pgfmathtruncatemacro\lp{\l-1}%
        \edef\hw@na{\csname hw@mlp@\lp\endcsname}\edef\hw@nb{\csname hw@mlp@\l\endcsname}%
        \foreach \a in {1,...,\hw@na}{\foreach \b in {1,...,\hw@nb}{%
          \draw[hwcwire,line width=0.3pt] (-l\lp-\a)--(-l\l-\b);}}}%
    \fi
  }},
}

% ---- layout check: \usepackage[check]{hwfig} or \hwsetup{check} before the
%      picture.  Warns (and marks in red) when two boxes overlap, a wire label
%      sits on a box, a wire runs through a box, or a wire is too short for
%      its arrow tip.  Exempt one node with the `nocheck' key. -----------------
\newif\ifhw@check
\newdimen\hw@xa\newdimen\hw@ya\newdimen\hw@xb\newdimen\hw@yb
\newdimen\hw@px\newdimen\hw@py\newdimen\hw@pd
\newcount\hw@nprob\newcount\hw@i\newcount\hw@j
\let\hw@b\relax\let\hw@l\relax\let\hw@p\relax\let\hw@w\relax
\def\hw@chkinit{\gdef\hw@boxes{}\gdef\hw@lbls{}\gdef\hw@pts{}\gdef\hw@skips{,}\global\hw@nprob=0 }
\def\hw@mm#1{%
  \pgfextractx\hw@px{\pgfpointtransformed{\pgfpointanchor{\hw@n}{#1}}}%
  \pgfextracty\hw@py{\pgfpointtransformed{\pgfpointanchor{\hw@n}{#1}}}%
  \ifdim\hw@px<\hw@xa\hw@xa\hw@px\fi\ifdim\hw@px>\hw@xb\hw@xb\hw@px\fi
  \ifdim\hw@py<\hw@ya\hw@ya\hw@py\fi\ifdim\hw@py>\hw@yb\hw@yb\hw@py\fi}
\def\hw@rect{rectangle}\def\hw@rrect{rounded rectangle}\def\hw@cyl{cylinder}
% #1 = b (box) | l (label), #2 = node name
\def\hw@record#1#2{\begingroup\edef\hw@n{#2}%
  \hw@xa16000pt\hw@ya16000pt\hw@xb-16000pt\hw@yb-16000pt
  \hw@mm{west}\hw@mm{east}\hw@mm{south}\hw@mm{north}%
  \edef\hw@s{\csname pgf@sh@ns@\hw@n\endcsname}%
  \ifx\hw@s\hw@rect\else\ifx\hw@s\hw@rrect\else\ifx\hw@s\hw@cyl\else  % round shapes: inner 70%
    \hw@px\dimexpr(\hw@xb-\hw@xa)*15/100\relax\advance\hw@xa\hw@px\advance\hw@xb-\hw@px
    \hw@py\dimexpr(\hw@yb-\hw@ya)*15/100\relax\advance\hw@ya\hw@py\advance\hw@yb-\hw@py
  \fi\fi\fi
  \if b#1\xdef\hw@boxes{\hw@boxes\hw@b{\hw@n}{\the\hw@xa}{\the\hw@ya}{\the\hw@xb}{\the\hw@yb}}%
  \else\xdef\hw@lbls{\hw@lbls\hw@l{\hw@n}{\the\hw@xa}{\the\hw@ya}{\the\hw@xb}{\the\hw@yb}}\fi
  \endgroup}
\def\hw@sample#1#2{%
  \pgfextractx\hw@px{\pgfpointtransformed{#1}}\pgfextracty\hw@py{\pgfpointtransformed{#1}}%
  \xdef\hw@cur{\hw@cur\hw@p{\the\hw@px}{\the\hw@py}{#2}}}
\pgfdeclaredecoration{hw@probe}{init}{
  \state{init}[width=0pt,next state=s]{\gdef\hw@cur{}\global\hw@j0 }
  \state{s}[width=2.5pt]{\hw@sample{\pgfpointorigin}{\the\dimexpr2.5pt*\hw@j\relax}\global\advance\hw@j1 }
  \state{final}{\hw@sample{\pgfpointdecoratedpathlast}{\pgfdecoratedpathlength}%
    \xdef\hw@pts{\hw@pts\hw@w\hw@cur\hw@w}}
}
\tikzset{
  hw@trk/.code={\ifhw@check\tikzset{append after command={\pgfextra{\hw@record{#1}{\tikzlastnode}}}}\fi},
  hw@wire/.code={\ifhw@check\tikzset{postaction={decorate,decoration={hw@probe}}}\fi},
  hw@chk/.code={\ifhw@check\tikzset{execute at begin picture=\hw@chkinit,execute at end picture=\hw@chkrun}\fi},
  nocheck/.code={\ifhw@check\tikzset{append after command={\pgfextra{\xdef\hw@skips{\hw@skips\tikzlastnode,}}}}\fi},
}
% -- reporting
\def\hw@at#1#2#3#4{\pgfmathtruncatemacro\hw@cx{round((#1+#3)/5.69055)}%
  \pgfmathtruncatemacro\hw@cy{round((#2+#4)/5.69055)}\edef\hw@pos{(\hw@cx,\hw@cy)mm}}
\def\hw@desc#1#2#3#4#5{%  -> \hw@d : `name' or a position
  \edef\hw@t{\noexpand\in@{tikz@f@}{#1}}\hw@t
  \ifin@\hw@at{#2}{#3}{#4}{#5}\edef\hw@d{unnamed node near \hw@pos}\else\edef\hw@d{node `#1'}\fi}
\def\hw@warn#1{\global\advance\hw@nprob1 \PackageWarning{hwfig}{check: #1}}
\def\hw@markrect#1#2#3#4{\begin{pgfscope}\pgftransformreset\pgfsetfillcolor{red}\pgfsetfillopacity{0.45}%
  \pgfpathrectanglecorners{\pgfqpoint{#1}{#2}}{\pgfqpoint{#3}{#4}}\pgfusepath{fill}\end{pgfscope}}
\def\hw@markpt#1#2{\begin{pgfscope}\pgftransformreset\pgfsetstrokecolor{red}\pgfsetlinewidth{1pt}%
  \pgfpathcircle{\pgfqpoint{#1}{#2}}{4pt}\pgfusepath{stroke}\end{pgfscope}}
\def\hw@ifskip#1{\edef\hw@t{\noexpand\in@{,#1,}{\hw@skips}}\hw@t\ifin@\expandafter\@gobble\else\expandafter\@firstofone\fi}
% rectangles {A}{B}: overlap by more than #9 -> mark and run \hw@hit
\def\hw@isect#1#2#3#4#5#6#7#8#9{%
  \ifdim\dimexpr#1+#9\relax<#7\ifdim\dimexpr#5+#9\relax<#3%
  \ifdim\dimexpr#2+#9\relax<#8\ifdim\dimexpr#6+#9\relax<#4%
    \hw@xa#1\ifdim#5>\hw@xa\hw@xa#5\fi\hw@ya#2\ifdim#6>\hw@ya\hw@ya#6\fi
    \hw@xb#3\ifdim#7<\hw@xb\hw@xb#7\fi\hw@yb#4\ifdim#8<\hw@yb\hw@yb#8\fi
    \hw@markrect{\hw@xa}{\hw@ya}{\hw@xb}{\hw@yb}\hw@hit
  \fi\fi\fi\fi}
\def\hw@chkrun{\begingroup
  % 1. box / box
  \hw@i0
  \def\hw@b##1##2##3##4##5{\advance\hw@i1 \hw@ifskip{##1}{%
    \begingroup\hw@j0
    \def\hw@b####1####2####3####4####5{\advance\hw@j1
      \ifnum\hw@j>\hw@i\hw@ifskip{####1}{%
        \def\hw@hit{\hw@desc{##1}{##2}{##3}{##4}{##5}\let\hw@da\hw@d
          \hw@desc{####1}{####2}{####3}{####4}{####5}\hw@warn{\hw@da\space and \hw@d\space overlap}}%
        \hw@isect{##2}{##3}{##4}{##5}{####2}{####3}{####4}{####5}{1pt}}\fi}%
    \hw@boxes\endgroup}}%
  \hw@boxes
  % 2. label / box
  \def\hw@l##1##2##3##4##5{\hw@ifskip{##1}{%
    \begingroup
    \def\hw@b####1####2####3####4####5{\hw@ifskip{####1}{%
      \def\hw@hit{\hw@desc{####1}{####2}{####3}{####4}{####5}\hw@at{##2}{##3}{##4}{##5}%
        \hw@warn{a wire label near \hw@pos\space overlaps \hw@d}}%
      \hw@isect{##2}{##3}{##4}{##5}{####2}{####3}{####4}{####5}{1.5pt}}}%
    \hw@boxes\endgroup}}%
  \hw@lbls
  % 3. wire through box (boxes shrunk by 2pt so border contacts do not count)
  \def\hw@b##1##2##3##4##5{\hw@ifskip{##1}{%
    \begingroup\let\hw@f\relax
    \def\hw@w{\let\hw@f\relax}%
    \def\hw@p####1####2####3{\ifx\hw@f\relax
      \ifdim####1>\dimexpr##2+2pt\relax\ifdim####1<\dimexpr##4-2pt\relax
      \ifdim####2>\dimexpr##3+2pt\relax\ifdim####2<\dimexpr##5-2pt\relax
        \def\hw@f{1}\hw@markpt{####1}{####2}\hw@desc{##1}{##2}{##3}{##4}{##5}%
        \hw@warn{a wire runs through \hw@d}%
      \fi\fi\fi\fi\fi}%
    \hw@pts\endgroup}}%
  \hw@boxes
  % 4. wires too short for their arrow tip, or bent right before the tip
  \def\hw@A{}\def\hw@B{}\def\hw@C{}\def\hw@D{}%
  \def\hw@p##1##2##3{\let\hw@A\hw@B\let\hw@B\hw@C\let\hw@C\hw@D\def\hw@D{{##1}{##2}{##3}}}%
  \def\hw@w{\ifx\hw@D\@empty\else\expandafter\hw@tip\hw@D\fi
    \def\hw@A{}\def\hw@B{}\def\hw@C{}\def\hw@D{}}%
  \def\hw@tip##1##2##3{%
    \ifdim##3<7pt \hw@markpt{##1}{##2}\hw@at{##1}{##2}{##1}{##2}%
      \hw@warn{the wire ending near \hw@pos\space is shorter than its arrow tip}%
    \else\ifx\hw@A\@empty\else\expandafter\hw@bend\hw@A{##1}{##2}{##3}\fi\fi}%
  \def\hw@bend##1##2##3##4##5##6{%
    \hw@pd\dimexpr##6-##3\relax
    \pgfmathparse{veclen(##4-##1,##5-##2)<0.9*\hw@pd}%
    \ifnum\pgfmathresult=1 \hw@markpt{##4}{##5}\hw@at{##4}{##5}{##4}{##5}%
      \hw@warn{the wire ending near \hw@pos\space bends inside its arrow tip: lengthen the last segment}\fi}%
  \hw@pts
  \typeout{hwfig check: \the\hw@nprob\space problem(s) in the picture ending on line \the\inputlineno}%
  \endgroup}

% ---- apply the package options ------------------------------------------------
\edef\hw@tmp{\noexpand\hwsetup{\hw@opts}}\hw@tmp
\endinput
