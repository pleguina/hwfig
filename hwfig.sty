\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hwfig}[2026/11/11 v1.1 hardware figure styles]
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,fit,backgrounds,calc,shapes.geometric,decorations.markings}

% ---- options: \usepackage[<palette>]{hwfig} or [palette=<palette>] ----------
\def\hw@initpal{grey}
\def\hw@setopt#1=#2\@nil{\def\hw@tmp{#2}%
  \ifx\hw@tmp\@empty\edef\hw@initpal{#1}\else\hw@setopt@b#2\@nil\fi}
\def\hw@setopt@b#1=\@nil{\edef\hw@initpal{#1}}
\DeclareOption*{\expandafter\hw@setopt\CurrentOption=\@nil}
\ProcessOptions\relax

% ---- role colours: <role>D = draw, <role>F = fill --------------------------
% Public API for custom palettes:
%   \hwdefinepalette{mine}{%
%     \hwrole{io}{black}{white} \hwrole{comp}{blue}{blue!10} ...   (8 roles:
%       io comp quant const op mem ctrl group)
%     \hwwires{<wire>}{<constant wire>}{<accent / hot path>}}
\newcommand\hw@role[3]{\colorlet{hw#1D}{#2}\colorlet{hw#1F}{#3}}
\newcommand\hwrole[3]{\hw@role{#1}{#2}{#3}}
\newcommand\hwwires[3]{\colorlet{hwwire}{#1}\colorlet{hwcwire}{#2}\colorlet{hwaccent}{#3}}
\newcommand\hwdefinepalette[2]{\expandafter\def\csname hw@pal@#1\endcsname{#2}}

\newcommand\hwpalette[1]{%
  \ifcsname hw@pal@#1\endcsname\csname hw@pal@#1\endcsname
  \else\PackageError{hwfig}{Unknown palette `#1'}%
    {Built-in palettes: grey, okabe, tol, nord, slate.\MessageBreak
     Define your own with \string\hwdefinepalette.}\fi}

% Greyscale: print-safe, matches the original template
\newcommand\hw@pal@grey{%
  \hw@role{io}{black}{white}%
  \hw@role{comp}{black}{white}%
  \hw@role{quant}{black}{gray!20}%
  \hw@role{const}{black!70}{gray!8}%
  \hw@role{op}{black}{gray!12}%
  \hw@role{mem}{black}{gray!25}%
  \hw@role{ctrl}{black}{gray!35}%
  \hw@role{group}{black!60}{gray!4}%
  \colorlet{hwwire}{black}\colorlet{hwcwire}{black!60}\colorlet{hwaccent}{black}}

