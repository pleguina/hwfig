  \hw@role{quant}{hwOIorange!80!black}{hwOIorange!20}%
  \hw@role{const}{black!55}{black!5}%
  \hw@role{op}{hwOIverm!85!black}{hwOIverm!12}%
  \hw@role{mem}{hwOIgreen!80!black}{hwOIgreen!16}%
  \hw@role{ctrl}{hwOIpurple!80!black}{hwOIpurple!16}%
