% Usage:  \usepackage{hwfig}                       % grey palette, classic look
%         \usepackage[okabe]{hwfig}                % or palette=okabe
%         \usepackage[ngt,shape=round,font=sans]{hwfig}
%         \hwpalette{grey|okabe|tol|bright|ibm|nord|slate|cern|
%                     ngt|ngtdark|ngtblue|ngtnight}
%         \hwshape{classic|soft|round|pill|sharp}  \hwfill{tint|solid|outline}
%         \hwfont{serif|sans|mono}                 \hwline{thin|normal|bold}
%         \hwsetup{palette=ngt,shape=round,fill=solid,font=sans,line=bold,shadow}
%         \usepackage[check]{hwfig}   % warn about overlaps and bad wires
%   All of these are group-local, so they can differ per figure.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hwfig}[2026/11/15 v1.2 hardware figure styles]
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,fit,backgrounds,calc,shapes.geometric,
  shapes.misc,shapes.symbols,shadows,decorations.markings,decorations.pathreplacing}
\pgfdeclarelayer{hwcanvas}\pgfsetlayers{hwcanvas,background,main}

% ---- options: collected here, applied once everything is defined ------------
\def\hw@opts{}
\DeclareOption*{\edef\hw@opts{\hw@opts,\CurrentOption}}
\ProcessOptions\relax

% ---- role colours ----------------------------------------------------------
% Each role <r> in {io comp quant const op mem ctrl group} owns
%   hw<r>D  draw colour          hw<r>F  tint (palette-given, never altered)
%   hw<r>B  box fill             hw<r>T  box text       hw<r>L  detail lines
% B/T/L are derived from D/F by the fill mode (\hwfill).
% Public API for custom palettes:
%   \hwdefinepalette{mine}{%
%     \hwrole{io}{black}{white} \hwrole{comp}{blue}{blue!10} ...   (8 roles)
%     \hwwires{<wire>}{<constant wire>}{<accent / hot path>}
%     \hwink{<text>}{<paper>}}      % optional, default black on white
\newcommand\hw@role[3]{\colorlet{hw#1D}{#2}\colorlet{hw#1F}{#3}}
\newcommand\hwrole[3]{\hw@role{#1}{#2}{#3}}
\newcommand\hwwires[3]{\colorlet{hwwire}{#1}\colorlet{hwcwire}{#2}\colorlet{hwaccent}{#3}}
\newcommand\hwink[2]{\colorlet{hwtext}{#1}\colorlet{hwpaper}{#2}}
\newcommand\hwdefinepalette[2]{\expandafter\def\csname hw@pal@#1\endcsname{#2}}

\def\hw@roles{io,comp,quant,const,op,mem,ctrl,group}
\def\hw@fillmode{tint}
\def\hw@solid{solid}
\def\hw@btl@tint#1{\colorlet{hw#1B}{hw#1F}\colorlet{hw#1T}{hwtext}\colorlet{hw#1L}{hw#1D}}
\def\hw@btl@solid#1{\colorlet{hw#1B}{hw#1D}\colorlet{hw#1T}{hwpaper}\colorlet{hw#1L}{hwpaper}}
\def\hw@btl@outline#1{\colorlet{hw#1B}{hwpaper}}
\def\hw@each#1#2{\@for\hw@r:=#2\do{\expandafter#1\expandafter{\hw@r}}}
\def\hw@fill@tint{}
\def\hw@fill@solid{\hw@each\hw@btl@solid{comp,quant,op,mem,ctrl}}
\def\hw@fill@outline{\hw@each\hw@btl@outline\hw@roles}
\newcommand\hw@applyfill{\hw@each\hw@btl@tint\hw@roles\csname hw@fill@\hw@fillmode\endcsname}

\newcommand\hwpalette[1]{%
  \ifcsname hw@pal@#1\endcsname
    \edef\hw@curpal{#1}\hwink{black}{white}%
    \csname hw@pal@#1\endcsname\hw@applyfill
  \else\PackageError{hwfig}{Unknown palette `#1'}%
    {Built-in palettes: grey, okabe, tol, bright, ibm, nord, slate,\MessageBreak
     cern, ngt, ngtdark, ngtblue, ngtnight.  Define your own with \string\hwdefinepalette.}\fi}

% ---- fill mode: tint (default) | solid (saturated boxes, paper-coloured
%      text; io/const/group stay light) | outline (no fill) ------------------
\newcommand\hwfill[1]{%
  \ifcsname hw@fill@#1\endcsname\def\hw@fillmode{#1}\hw@applyfill
  \else\PackageError{hwfig}{Unknown fill mode `#1'}{Use tint, solid or outline.}\fi}

% ---- shape theme: corner radii and the port shape ---------------------------
%   \hw@rcbox  compute / quant / memory boxes     \hw@rcio  ctrl, frames
%   \hw@ioshape + \hw@rcport  runtime / ctime ports
\def\hw@shape@classic{\def\hw@rcbox{0pt}\def\hw@rcio{4pt}\def\hw@rcport{4pt}\def\hw@ioshape{rectangle}}
\def\hw@shape@sharp{\def\hw@rcbox{0pt}\def\hw@rcio{0pt}\def\hw@rcport{0pt}\def\hw@ioshape{rectangle}}
\def\hw@shape@soft{\def\hw@rcbox{2pt}\def\hw@rcio{4pt}\def\hw@rcport{4pt}\def\hw@ioshape{rectangle}}
\def\hw@shape@round{\def\hw@rcbox{4pt}\def\hw@rcio{6pt}\def\hw@rcport{6pt}\def\hw@ioshape{rectangle}}
\def\hw@shape@pill{\def\hw@rcbox{3pt}\def\hw@rcio{5pt}\def\hw@rcport{0pt}\def\hw@ioshape{rounded rectangle}}
\newcommand\hwshape[1]{%
  \ifcsname hw@shape@#1\endcsname\csname hw@shape@#1\endcsname
  \else\PackageError{hwfig}{Unknown shape theme `#1'}{Use classic, soft, round, pill or sharp.}\fi}
\hw@shape@classic

% ---- font family: serif | sans | mono | any font commands -------------------
%   e.g. \hwfont{\sffamily\sansmath} with the sansmath package for sans maths
\def\hw@font@serif{\rmfamily}\def\hw@font@sans{\sffamily}\def\hw@font@mono{\ttfamily}
\def\hw@ff{}
\newcommand\hwfont[1]{%
  \ifcsname hw@font@\detokenize{#1}\endcsname
    \expandafter\let\expandafter\hw@ff\csname hw@font@\detokenize{#1}\endcsname
  \else\def\hw@ff{#1}\fi}

% ---- line weight: thin | normal | bold | <dimension> ------------------------
\def\hw@line@thin{0.35pt}\def\hw@line@normal{0.5pt}\def\hw@line@bold{0.8pt}
\def\hw@lw{0.5pt}
\newcommand\hwline[1]{%
  \ifcsname hw@line@#1\endcsname\edef\hw@lw{\csname hw@line@#1\endcsname}\else\def\hw@lw{#1}\fi
  \pgfsetlinewidth{\hw@lw}}

% ---- soft drop shadow under boxes (slides) ----------------------------------
\newif\ifhw@shadow
\newcommand\hwshadow[1][true]{\csname hw@shadow#1\endcsname}

% ---- one-stop setup; also the package options -------------------------------
\pgfkeys{/hwsetup/.is family,/hwsetup/.cd,
  palette/.code=\hwpalette{#1}, shape/.code=\hwshape{#1}, fill/.code=\hwfill{#1},
  font/.code=\hwfont{#1}, line/.code=\hwline{#1},
  shadow/.code=\hwshadow[#1], shadow/.default=true,
  check/.code=\csname hw@check#1\endcsname, check/.default=true,
  .unknown/.code={\edef\hw@tmp{\noexpand\hwpalette{\pgfkeyscurrentname}}\hw@tmp}}
\newcommand\hwsetup[1]{\pgfkeys{/hwsetup/.cd,#1}}

