% ---- styles ----------------------------------------------------------------
\tikzset{
  hw/.style={font=\hw@ff\footnotesize, line width=\hw@lw, color=hwtext, >={Latex[length=2mm]}, hw@chk},
  % internal: role colours + optional shadow; port shape of the current theme
  hw@box/.style={draw=hw#1D,fill=hw#1B,text=hw#1T,hw@fx,hw@trk=b},
  hw@fx/.code={\ifhw@shadow\tikzset{drop shadow={opacity=0.22,shadow xshift=1.3pt,shadow yshift=-1.3pt}}\fi},
  hw@port/.code={\edef\hw@tmp{\noexpand\tikzset{shape=\hw@ioshape,rounded corners=\hw@rcport}}\hw@tmp},
  % run-time data / ports
  runtime/.style={hw@box=io,hw@port,minimum height=0.6cm,align=center,inner sep=3pt},
  % compile-time constants (weights, scales, config)
  ctime/.style={hw@box=const,dashed,hw@port,minimum height=0.5cm,align=center,inner sep=2pt,font=\hw@ff\footnotesize},
  % compute kernel / HLS function / AIE kernel
  hlsbox/.style={hw@box=comp,rounded corners=\hw@rcbox,minimum height=0.8cm,minimum width=1.9cm,align=center,inner sep=3pt},
  % quantiser / requantise / saturate
  qbox/.style={hw@box=quant,rounded corners=\hw@rcbox,minimum height=0.7cm,minimum width=1.35cm,align=center,inner sep=2pt},
  % memory: BRAM/URAM/DDR buffer (double top/bottom rule)
  mem/.style={hw@box=mem,rounded corners=\hw@rcbox,minimum height=0.8cm,minimum width=1.6cm,align=center,inner sep=3pt,
    path picture={\draw[hwmemL,sharp corners] ($(path picture bounding box.north west)+(0,-2pt)$)--($(path picture bounding box.north east)+(0,-2pt)$);
                  \draw[hwmemL,sharp corners] ($(path picture bounding box.south west)+(0,2pt)$)--($(path picture bounding box.south east)+(0,2pt)$);}},
  % FIFO / stream: vertical slots on the right
  fifo/.style={hw@box=mem,rounded corners=\hw@rcbox,minimum height=0.6cm,minimum width=1.4cm,align=center,inner sep=2pt,
    path picture={\foreach \k in {1,2,3}{\draw[hwmemL,sharp corners] ($(path picture bounding box.north east)+(-\k*3pt,0)$)--($(path picture bounding box.south east)+(-\k*3pt,0)$);}}},
  % register with clock wedge
  reg/.style={hw@box=mem,rounded corners=\hw@rcbox,minimum height=0.7cm,minimum width=0.55cm,inner sep=1pt,
    path picture={\draw[hwmemL,sharp corners] ($(path picture bounding box.south)+(-3pt,0)$)--($(path picture bounding box.south)+(0,4pt)$)--($(path picture bounding box.south)+(3pt,0)$);}},
  % control / FSM / scheduler
  ctrl/.style={hw@box=ctrl,rounded corners=\hw@rcio,minimum height=0.7cm,minimum width=1.6cm,align=center,inner sep=3pt},
  % arithmetic operator (+, x, max)
  op/.style={hw@box=op,circle,minimum size=0.55cm,inner sep=0pt},
  % multiplexer (inputs on west, output on east)
  mux/.style={hw@trk=b,text=hwopT,minimum width=0.45cm,minimum height=1cm,inner sep=0pt,font=\hw@ff\scriptsize,
    path picture={\path[draw=hwopD,fill=hwopB,line width=\hw@lw]
      ($(path picture bounding box.north west)+(0.25pt,-0.25pt)$)--($(path picture bounding box.north east)+(-0.25pt,-6pt)$)
      --($(path picture bounding box.south east)+(-0.25pt,6pt)$)--($(path picture bounding box.south west)+(0.25pt,0.25pt)$)--cycle;}},
  % demultiplexer (input on west, outputs on east)
  demux/.style={hw@trk=b,text=hwopT,minimum width=0.45cm,minimum height=1cm,inner sep=0pt,font=\hw@ff\scriptsize,
    path picture={\path[draw=hwopD,fill=hwopB,line width=\hw@lw]
      ($(path picture bounding box.north west)+(0.25pt,-6pt)$)--($(path picture bounding box.north east)+(-0.25pt,-0.25pt)$)
      --($(path picture bounding box.south east)+(-0.25pt,0.25pt)$)--($(path picture bounding box.south west)+(0.25pt,6pt)$)--cycle;}},
  % grouping frame (use on background layer with fit=...)
  group/.style={draw=hwgroupD,fill=hwgroupB,rounded corners=\hw@rcio,inner sep=5pt},
  grouplabel/.style={font=\hw@ff\footnotesize\itshape,text=hwgroupD!80!hwtext},
  % wires
  arr/.style={hw@wire,draw=hwwire,-{Latex[length=2mm]}},
  darr/.style={hw@wire,draw=hwcwire,-{Latex[length=1.8mm]},dashed},
  bus/.style={hw@wire,draw=hwwire,line width=2.4*\hw@lw,-{Latex[length=2.4mm,width=2mm]}},
  hot/.style={hw@wire,draw=hwaccent,line width=2*\hw@lw,-{Latex[length=2mm]}},  % highlighted / critical path
  % edge label (protocol / signal name), e.g.  node[lbl]{AXI4-S}
  lbl/.style={font=\hw@ff\scriptsize,inner sep=1.5pt,text=hwwire,hw@trk=l},
  % same, with a white backing so it stays readable over crossing wires
  lblbox/.style={lbl,fill=hwpaper,inner sep=1pt},
  % --- FPGA / SoC primitives --------------------------------------------
