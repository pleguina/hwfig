  cpu/.style={hw@box=ctrl,rounded corners=\hw@rcbox,double=hwpaper,double distance=1.2pt,minimum width=1.8cm,minimum height=1cm,align=center,inner sep=3pt}, % PS / ARM / RISC-V
  host/.style={hw@box=io,rounded corners=\hw@rcbox,minimum width=1.8cm,minimum height=1cm,align=center,inner sep=3pt,
