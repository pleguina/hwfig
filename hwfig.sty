% Slate: blue-grey + mauve + coral (scientific-slide look)
\definecolor{hwSslate}{HTML}{4A6378}\definecolor{hwSmauve}{HTML}{9B7BA6}
\definecolor{hwScoral}{HTML}{E07A5F}\definecolor{hwSsage}{HTML}{81A684}
