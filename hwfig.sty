\definecolor{hwOIgreen}{HTML}{009E73}\definecolor{hwOIsky}{HTML}{56B4E9}
\definecolor{hwOIverm}{HTML}{D55E00}\definecolor{hwOIpurple}{HTML}{CC79A7}
