\definecolor{hwTsand}{HTML}{DDCC77}\definecolor{hwTrose}{HTML}{CC6677}
\definecolor{hwTwine}{HTML}{882255}\definecolor{hwTcyan}{HTML}{88CCEE}
\newcommand\hw@pal@tol{%
  \hw@role{io}{black!80}{white}%
  \hw@role{comp}{hwTindigo}{hwTcyan!22}%
  \hw@role{quant}{hwTsand!60!black}{hwTsand!35}%
  \hw@role{const}{black!55}{black!5}%
  \hw@role{op}{hwTwine}{hwTrose!15}%
  \hw@role{mem}{hwTteal!75!black}{hwTteal!20}%
  \hw@role{ctrl}{hwTrose!80!black}{hwTrose!20}%
  \hw@role{group}{hwTindigo!40}{hwTcyan!6}%
  \colorlet{hwwire}{black!85}\colorlet{hwcwire}{black!50}\colorlet{hwaccent}{hwTwine}}

% Nord: cool, slide-friendly
\definecolor{hwNblue}{HTML}{5E81AC}\definecolor{hwNfrost}{HTML}{88C0D0}
\definecolor{hwNgreen}{HTML}{A3BE8C}\definecolor{hwNyellow}{HTML}{EBCB8B}
\definecolor{hwNred}{HTML}{BF616A}\definecolor{hwNpurple}{HTML}{B48EAD}
\definecolor{hwNdark}{HTML}{2E3440}
\newcommand\hw@pal@nord{%
  \hw@role{io}{hwNdark}{white}%
  \hw@role{comp}{hwNblue!90!black}{hwNfrost!25}%
  \hw@role{quant}{hwNyellow!55!black}{hwNyellow!35}%
  \hw@role{const}{hwNdark!55}{hwNdark!4}%
  \hw@role{op}{hwNred!85!black}{hwNred!14}%
  \hw@role{mem}{hwNgreen!60!black}{hwNgreen!28}%
  \hw@role{ctrl}{hwNpurple!80!black}{hwNpurple!22}%
